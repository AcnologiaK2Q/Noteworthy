# Supabase: Project Settings > Data API (URL, anon key) and Settings > API Keys (service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deployed embed Edge Function: https://<project-ref>.functions.supabase.co/embed
SUPABASE_EDGE_EMBED_URL=

# Groq: free API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile
GROQ_MODEL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
